{
	"FileVersion": 3,
	"Version": 1,
	"VersionName": "2.0.0",
	"FriendlyName": "UEAssetLens",
	"Description": "Deterministic, offline asset specification indexer. Zero VLM, AssetRegistry-based incremental scan + headless Commandlet, writes asset specs to .ual/index.duckdb.",
	"Category": "Editor",
	"CreatedBy": "AnnBuildTools",
	"EnabledByDefault": true,
	"CanContainContent": false,
	"IsBetaVersion": false,
	"Installed": false,
	"Modules": [
		{
			"Name": "UEAssetLens",
			"Type": "Runtime",
			"LoadingPhase": "Default"
		},
		{
			"Name": "UEAssetLensEditor",
			"Type": "Editor",
			"LoadingPhase": "PostEngineInit"
		},
		{
			"Name": "UEAssetLensTests",
			"Type": "Editor",
			"LoadingPhase": "PostEngineInit"
		},
		{
			"Name": "UEAssetLensMCP",
			"Type": "Editor",
			"LoadingPhase": "PostEngineInit"
		}
	],
	"Plugins": [
		{
			"Name": "ModelContextProtocol",
			"Enabled": true,
			"Optional": true
		}
	],
	"SupportedTargetPlatforms": ["Win64", "Mac", "Linux", "Android", "IOS"],
	"DocsURL": "https://hustjjd.github.io/UEAssetLens/",
	"SupportURL": "https://github.com/HUSTJJD/UEAssetLens/issues",
	"CreatedByURL": "https://github.com/HUSTJJD/UEAssetLens"
}
